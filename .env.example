# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud OAuth client (APIs & Services -> Credentials)
# Configure this as a "Web application" client and also enable it as the
# Google provider in Supabase Auth (Authentication -> Providers -> Google)
# using the same client id/secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Shared secret for the scheduled sync endpoint. Set the same value in
# Vercel's cron configuration / environment variables.
CRON_SECRET=

# Your app's base URL. http://localhost:3000 for local dev, your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
